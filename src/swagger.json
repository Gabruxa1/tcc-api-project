{
	"openapi": "3.0.0",
	"info": {
		"title": "API de Funcionários e Pontos",
		"version": "1.0.0"
	},
	"paths": {
		"/connect/token": {
			"post": {
				"summary": "Geração de Token",
				"description": "Essa rota gera um token JWT para autenticação.",
				"tags": ["Autenticação"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/login"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Token gerado com sucesso",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"token": {
											"type": "string"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Bad Request"
					},
					"401": {
						"description": "Unauthorized"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/funcionarios": {
			"get": {
				"summary": "Obter todos os funcionários",
				"description": "Essa rota obtém todos os funcionários cadastrados.",
				"tags": ["Funcionários"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/response_employee"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"post": {
				"summary": "Criar funcionário",
				"description": "Essa rota cadastra um novo funcionário.",
				"tags": ["Funcionários"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/employee"
							}
						}
					}
				},
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"201": {
						"description": "Funcionário cadastrado com sucesso"
					},
					"400": {
						"description": "Bad Request"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/funcionarios/ativos": {
			"get": {
				"summary": "Obter funcionários ativos",
				"description": "Essa rota obtém todos os funcionários ativos.",
				"tags": ["Funcionários"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/response_employee"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/funcionarios/{id}": {
			"get": {
				"summary": "Obter funcionário por ID",
				"description": "Essa rota obtém um funcionário específico pelo ID.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Funcionário encontrado",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/response_employee"
							}
						}
					},
					"404": {
						"description": "Funcionário não encontrado"
					}
				}
			},
			"put": {
				"summary": "Atualizar funcionário",
				"description": "Essa rota atualiza os dados de um funcionário.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/employee"
							}
						}
					}
				},
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Funcionário atualizado com sucesso"
					},
					"404": {
						"description": "Funcionário não encontrado"
					}
				}
			},
			"delete": {
				"summary": "Excluir funcionário",
				"description": "Essa rota exclui um funcionário específico.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Funcionário excluído com sucesso"
					},
					"404": {
						"description": "Funcionário não encontrado"
					}
				}
			}
		},
		"/pontos": {
			"get": {
				"summary": "Obter todos os registros de ponto",
				"description": "Essa rota retorna todos os registros de ponto cadastrados.",
				"tags": ["Pontos"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/ponto"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"post": {
				"summary": "Registrar ponto",
				"description": "Essa rota registra um novo ponto para um funcionário.",
				"tags": ["Pontos"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ponto"
							}
						}
					}
				},
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"201": {
						"description": "Ponto registrado com sucesso"
					},
					"400": {
						"description": "Bad Request"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/pontos/{id}/{data}": {
			"get": {
				"summary": "Obter registro de ponto por ID e data",
				"description": "Essa rota obtém um registro de ponto específico pelo ID e data.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "data",
						"in": "path",
						"description": "Data do registro de ponto no formato YYYY-MM-DD",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Registro de ponto encontrado",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/ponto"
							}
						}
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					}
				}
			},
			"put": {
				"summary": "Atualizar registro de ponto",
				"description": "Essa rota atualiza um registro de ponto específico pelo ID e data.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "data",
						"in": "path",
						"description": "Data do registro de ponto no formato YYYY-MM-DD",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ponto"
							}
						}
					}
				},
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Registro de ponto atualizado com sucesso"
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					}
				}
			},
			"delete": {
				"summary": "Excluir registro de ponto",
				"description": "Essa rota exclui um registro de ponto específico pelo ID e data.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "data",
						"in": "path",
						"description": "Data do registro de ponto no formato YYYY-MM-DD",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "Registro de ponto excluído com sucesso"
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					}
				}
			}
		},
		"/relatorios/{id}/{data}": {
			"get": {
				"summary": "Gerar relatório",
				"description": "Essa rota gera um relatório com base nos registros de ponto.",
				"tags": ["Relatórios"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "query",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "data_inicio",
						"in": "query",
						"description": "Data de início no formato YYYY-MM-DD",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					},
					{
						"name": "data_fim",
						"in": "query",
						"description": "Data de fim no formato YYYY-MM-DD",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Relatório gerado com sucesso",
						"content": {
							"application/json": {
								"type": "object",
								"properties": {
									"relatorio": {
										"type": "array",
										"items": {
											"$ref": "#/components/schemas/relatorio"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Bad Request"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"login": {
				"type": "object",
				"properties": {
					"email": {
						"type": "string"
					},
					"senha": {
						"type": "string"
					}
				},
				"required": ["email", "senha"]
			},
			"employee": {
				"type": "object",
				"properties": {
					"nome": {
						"type": "string"
					},
					"cpf": {
						"type": "string"
					},
					"telefone": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"senha": {
						"type": "string"
					},
					"funcao": {
						"type": "string"
					},
					"admin": {
						"type": "boolean"
					},
					"ativo": {
						"type": "boolean"
					},
					"custo_hora": {
						"type": "number"
					}
				},
				"required": ["nome", "cpf", "telefone", "email", "senha", "funcao", "admin", "ativo", "custo_hora"]
			},
			"response_employee": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"nome": {
						"type": "string"
					},
					"cpf": {
						"type": "string"
					},
					"telefone": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"funcao": {
						"type": "string"
					},
					"admin": {
						"type": "boolean"
					},
					"ativo": {
						"type": "boolean"
					},
					"custo_hora": {
						"type": "number"
					}
				}
			},
			"ponto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"data": {
						"type": "string",
						"format": "date"
					},
					"entrada": {
						"type": "string",
						"format": "date-time"
					},
					"saida": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["data", "entrada", "saida"]
			},
			"relatorio": {
				"type": "object",
				"properties": {
					"data": {
						"type": "string",
						"format": "date"
					},
					"horas_trabalhadas": {
						"type": "number"
					}
				}
			}
		},
		"securitySchemes": {
			"BearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	}
}
