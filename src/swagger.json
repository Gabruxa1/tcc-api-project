{
	"openapi": "3.0.0",
	"info": {
		"title": "API de Manipulação de Funcionários e Registros de Pontos",
		"description": "Essa API tem como finalidade manipular os dados referentes a funcionários e registros de pontos.",
		"contact": {
			"email": "gabriel.harik@gmail.com"
		},
		"version": "1.0.0"
	},
	"servers": [
		{
			"url": "http://localhost:433",
			"description": "API de testes"
		}
	],
	"paths": {
		"/connect/token": {
			"post": {
				"summary": "Geração de Token",
				"description": "Gera um token de autenticação para o usuário utilizando email e senha.",
				"tags": ["Auth"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"email": {
										"type": "string",
										"format": "email",
										"description": "Email do usuário",
										"example": "usuario@example.com"
									},
									"senha": {
										"type": "string",
										"description": "Senha do usuário",
										"example": "sua_senha"
									}
								},
								"required": ["email", "senha"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Token gerado com sucesso.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"token": {
											"type": "string",
											"description": "O token JWT gerado para autenticação do usuário."
										}
									},
									"required": ["token"]
								}
							}
						}
					},
					"401": {
						"description": "Credenciais inválidas."
					},
					"403": {
						"description": "Usuário desativado."
					},
					"500": {
						"description": "Erro ao gerar token."
					}
				}
			}
		},
		"/funcionarios": {
			"post": {
				"summary": "Cadastro de novo funcionário",
				"description": "Essa rota será responsável por cadastrar um novo funcionário.",
				"tags": ["Funcionários"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/employee"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"description": "Funcionário cadastrado com sucesso",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/response_employee"
								}
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/response_bad_request"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"get": {
				"summary": "Obter todos os funcionários cadastrados",
				"description": "Essa rota será responsável por retornar todos os funcionários cadastrados.",
				"tags": ["Funcionários"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/employee"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/funcionarios/ativos": {
			"get": {
				"summary": "Obter funcionários ativos",
				"description": "Essa rota será responsável por retornar todos os funcionários ativos.",
				"tags": ["Funcionários"],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/employee"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/funcionarios/{id}": {
			"get": {
				"summary": "Obter funcionário pelo ID",
				"description": "Essa rota será responsável por retornar um funcionário específico com base no ID.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/employee"
							}
						}
					},
					"404": {
						"description": "Funcionário não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"delete": {
				"summary": "Remover funcionário",
				"description": "Essa rota será responsável por remover um funcionário com base no ID.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"204": {
						"description": "Funcionário removido com sucesso"
					},
					"404": {
						"description": "Funcionário não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"put": {
				"summary": "Atualizar funcionário",
				"description": "Essa rota será responsável por atualizar um funcionário com base no ID.",
				"tags": ["Funcionários"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do funcionário",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/employee"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Funcionário atualizado com sucesso",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/response_employee"
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/response_bad_request"
							}
						}
					},
					"404": {
						"description": "Funcionário não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/pontos": {
			"get": {
				"summary": "Obter todos os registros de pontos",
				"description": "Essa rota será responsável por retornar todos os registros de pontos.",
				"tags": ["Pontos"],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/pontos"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		},
		"/pontos/{id}": {
			"get": {
				"summary": "Obter registro de ponto pelo ID",
				"description": "Essa rota será responsável por retornar um registro de ponto específico com base no ID.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do registro de ponto",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/pontos"
							}
						}
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"delete": {
				"summary": "Remover registro de ponto",
				"description": "Essa rota será responsável por remover um registro de ponto com base no ID.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do registro de ponto",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"responses": {
					"204": {
						"description": "Registro de ponto removido com sucesso"
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			},
			"put": {
				"summary": "Atualizar registro de ponto",
				"description": "Essa rota será responsável por atualizar um registro de ponto com base no ID.",
				"tags": ["Pontos"],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID do registro de ponto",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/pontos"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Registro de ponto atualizado com sucesso",
						"content": {
							"application/json": {
								"$ref": "#/components/schemas/pontos"
							}
						}
					},
					"400": {
						"description": "Bad Request"
					},
					"404": {
						"description": "Registro de ponto não encontrado"
					},
					"500": {
						"description": "Internal Server Error"
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"BearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"employee": {
				"type": "object",
				"properties": {
					"nome": {
						"type": "string",
						"example": "João Silva"
					},
					"email": {
						"type": "string",
						"format": "email",
						"example": "joao.silva@example.com"
					},
					"senha": {
						"type": "string",
						"example": "sua_senha"
					},
					"admin": {
						"type": "boolean",
						"example": true
					},
					"ativo": {
						"type": "boolean",
						"example": true
					}
				},
				"required": ["nome", "email", "senha", "admin", "ativo"]
			},
			"response_employee": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"example": "123456"
					},
					"nome": {
						"type": "string",
						"example": "João Silva"
					},
					"email": {
						"type": "string",
						"format": "email",
						"example": "joao.silva@example.com"
					},
					"admin": {
						"type": "boolean",
						"example": true
					},
					"ativo": {
						"type": "boolean",
						"example": true
					}
				},
				"required": ["id", "nome", "email", "admin", "ativo"]
			},
			"response_bad_request": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "Erro ao cadastrar funcionário"
					}
				}
			},
			"pontos": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"example": "123456"
					},
					"data": {
						"type": "string",
						"format": "date-time",
						"example": "2024-10-13T12:00:00Z"
					},
					"hora_entrada": {
						"type": "string",
						"format": "date-time",
						"example": "2024-10-13T08:00:00Z"
					},
					"hora_saida": {
						"type": "string",
						"format": "date-time",
						"example": "2024-10-13T17:00:00Z"
					},
					"funcionario_id": {
						"type": "string",
						"example": "123456"
					}
				},
				"required": ["id", "data", "hora_entrada", "hora_saida", "funcionario_id"]
			}
		}
	}
}
